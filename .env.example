# ============================================================================
# متاهة الظلال — إعدادات حماية مفتاح API على الخادم (Server-Side Protection)
# ============================================================================
# انسخ هذا الملف إلى اسم (.env) وضع مفتاحك هنا، أو أضفه في Environment Variables
# في منصة الاستضافة (Vercel / Render / Railway).
# لن يظهر هذا المفتاح أبداً في كود المتصفح أو في تبويب الشبكة (DevTools Network)!

GEMINI_API_KEY=ضع_مفتاح_Google_AI_Studio_هنا
GEMINI_MODEL=gemini-3.8-flash

# الحد الأقصى للطلبات في الدقيقة لكل عنوان IP (لحماية رصيدك من الاستخدام المفرط)
RATE_LIMIT_PER_MINUTE=35

# اختياري: قصر استخدام الخادم على نطاق موقعك فقط عند الرفع (مثلاً https://mygame.vercel.app)
ALLOWED_ORIGIN=*
